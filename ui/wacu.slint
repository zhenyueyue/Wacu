import { Slider, ComboBox, Palette } from "std-widgets.slint";

global Tokens {
    out property <float> panel-scale: 1.0;
    out property <float> settings-scale: 1.0;
    out property <color> bg: #0f0f10;
    out property <color> panel: #1a1a1d;
    out property <color> raised: #26262b;
    out property <color> divider: #2f2f35;
    out property <color> text: #f5f5f5;
    out property <color> secondary: #a1a1aa;
    out property <color> muted: #71717a;
    out property <color> blue: #0085ff;
}

export struct Service {
    source-index: int, label: string, subtitle: string,
    percent: int, used: string, total: string, remaining: string, reset: string,
    accent: color, arc: string, visible: bool,
}

component Glyph inherits Image {
    in property <float> ui-scale: Tokens.panel-scale;
    width: 20px * root.ui-scale; height: 20px * root.ui-scale; image-fit: contain;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> animated: true;
    in property <float> ui-scale: Tokens.panel-scale;
    in property <length> icon-size: 20px * root.ui-scale;
    in property <length> icon-top: (root.height - root.icon-size) / 2;
    callback activated();
    width: 32px * root.ui-scale; height: 32px * root.ui-scale; border-radius: 8px * root.ui-scale;
    background: hit.pressed ? #35353b : (hit.has-hover ? Tokens.raised : transparent);
    animate background { duration: root.animated ? 100ms : 0ms; easing: ease-out; }
    Glyph { x: (parent.width - self.width) / 2; y: root.icon-top; width: root.icon-size; height: root.icon-size; source: root.icon; }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component QuotaItem inherits Rectangle {
    in property <Service> service;
    in property <bool> selected: false;
    in property <bool> panel-on-left: false;
    in property <bool> animated: true;
    callback activated();
    in property <int> size-mode: 1;
    property <length> ring-width: root.size-mode == 0 ? 3px : (root.size-mode == 1 ? 4px : 5px);
    width: root.size-mode == 0 ? 40px : (root.size-mode == 1 ? 56px : 72px);
    height: root.size-mode == 0 ? 52px : (root.size-mode == 1 ? 70px : 84px);
    border-radius: root.width / 2;
    background: hit.has-hover ? #26262b : transparent;
    opacity: hit.pressed ? 0.8 : 1;
    animate background, opacity { duration: root.animated ? 100ms : 0ms; easing: ease-out; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: hit.pressed ? 1px : 0px;
        width: (root.size-mode == 0 ? 36px : (root.size-mode == 1 ? 50px : 62px)) - (hit.pressed ? 2px : 0px);
        height: self.width; border-radius: self.width / 2;
        background: transparent;
        animate width, height, y { duration: root.animated ? 100ms : 0ms; easing: ease-out; }
        Path {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            commands: "M 0 0 L 0 0 M 56 56 L 56 56 M 28 4 A 24 24 0 1 1 28 52 A 24 24 0 1 1 28 4";
            stroke: #3b3e43; stroke-width: root.ring-width; fill: transparent;
        }
        Path {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            commands: root.service.arc; stroke: root.service.accent;
            stroke-width: root.ring-width; fill: transparent;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.size-mode == 0 ? 20px : (root.size-mode == 1 ? 28px : 36px);
            height: self.width; border-radius: self.width / 2;
            background: root.service.source-index == 1 ? #ff7042 : root.service.accent;
            drop-shadow-blur: root.selected ? 8px : 0px; drop-shadow-color: #3b82f666;
            Rectangle {
                x: parent.width * 0.24; y: parent.height * 0.35;
                width: parent.width * 0.17; height: self.width;
                border-radius: self.width / 2;
                background: root.service.source-index == 1 ? #fff9ef : #121215;
            }
            Rectangle {
                x: parent.width * 0.60; y: parent.height * 0.35;
                width: parent.width * 0.17; height: self.width;
                border-radius: self.width / 2;
                background: root.service.source-index == 1 ? #fff9ef : #121215;
            }
        }
    }
    Text {
        x: 0px; y: root.size-mode == 0 ? 33px : (root.size-mode == 1 ? 45px : 57px);
        width: parent.width; height: root.size-mode == 0 ? 15px : 19px;
        text: root.service.percent + "%";
        font-size: root.size-mode == 0 ? 12px : (root.size-mode == 1 ? 14px : 16px);
        font-family: "Bahnschrift"; font-weight: 500; color: Tokens.text;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.selected: Path {
        x: root.panel-on-left ? -8px : root.width; y: (root.size-mode == 0 ? 36px : (root.size-mode == 1 ? 50px : 62px)) / 2 - 6px; width: 8px; height: 12px;
        commands: root.panel-on-left ? "M 0 6 L 8 0 L 8 12 Z" : "M 8 6 L 0 0 L 0 12 Z";
        fill: Tokens.blue;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component CapsuleWindow inherits Window {
    title: "Wacu";
    in property <int> size-mode: 1;
    width: root.size-mode == 0 ? 72px : (root.size-mode == 1 ? 88px : 104px);
    property <length> item-height: root.size-mode == 0 ? 52px : (root.size-mode == 1 ? 70px : 84px);
    property <length> settings-height: root.size-mode == 0 ? 16px : (root.size-mode == 1 ? 20px : 24px);
    property <length> logo-size: root.size-mode == 0 ? 32px : (root.size-mode == 1 ? 40px : 48px);
    property <length> area-gap: root.size-mode == 0 ? 12px : (root.size-mode == 1 ? 16px : 20px);
    height: 56px + root.logo-size + root.area-gap * 2 + root.settings-height + root.item-height * max(1, visible-count);
    background: transparent; no-frame: true; always-on-top: true; default-font-family: "Segoe UI";
    icon: @image-url("../assets/tray.svg");
    in property <[Service]> services;
    in property <int> visible-count: 3;
    in-out property <int> selected-index: -1;
    in-out property <bool> panel-on-left: false;
    in-out property <bool> revealed: false;
    in property <bool> animated: true;
    in property <float> surface-opacity: 0.95;
    in property <bool> is-pinned: false;
    callback open-service(int);
    callback open-settings();
    callback start-drag();
    Rectangle {
        x: 12px; y: root.revealed ? 12px : 18px;
        width: parent.width - 24px; height: parent.height - 24px;
        border-radius: self.width / 2; border-width: 1px; border-color: root.selected-index >= 0 ? #3b82f6 : #45494a;
        background: #1b1c1f;
        opacity: root.revealed ? root.surface-opacity : 0;
        drop-shadow-blur: 14px; drop-shadow-offset-y: 4px; drop-shadow-color: root.selected-index >= 0 ? #3b82f633 : #00000050;
        animate y, opacity { duration: root.animated ? 200ms : 0ms; easing: ease-out; }
        TouchArea {
            width: parent.width; height: 16px; enabled: root.is-pinned; mouse-cursor: grab;
            pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.start-drag(); } }
        }
        VerticalLayout {
            padding-top: 16px; padding-bottom: 16px; padding-left: 4px; padding-right: 4px; spacing: 0px;
            HorizontalLayout {
                height: root.logo-size; alignment: center;
                Rectangle {
                    width: root.logo-size; height: root.logo-size;
                    Image {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        source: root.size-mode == 0 ? @image-url("../assets/logo-compact.png") : (root.size-mode == 1 ? @image-url("../assets/logo-standard.png") : @image-url("../assets/logo-spacious.png"));
                        image-fit: contain; image-rendering: smooth;
                    }
                    TouchArea {
                        enabled: root.is-pinned; mouse-cursor: grab;
                        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.start-drag(); } }
                    }
                }
            }
            Rectangle { height: root.area-gap; }
            if root.visible-count == 0: Rectangle {
                height: root.item-height;
                Text { text: "未启用\n服务"; color: Tokens.secondary; font-size: root.size-mode == 0 ? 10px : (root.size-mode == 1 ? 12px : 14px); horizontal-alignment: center; vertical-alignment: center; }
            }
            for service in root.services: QuotaItem {
                service: service; size-mode: root.size-mode;
                selected: root.selected-index == service.source-index;
                panel-on-left: root.panel-on-left; animated: root.animated;
                activated => { root.open-service(service.source-index); }
            }
            Rectangle { height: root.area-gap; }
            HorizontalLayout {
                height: root.settings-height; alignment: center;
                IconButton { height: root.settings-height; ui-scale: root.size-mode == 0 ? 1 : (root.size-mode == 1 ? 1.25 : 1.5); icon-size: root.settings-height; icon-top: 0px; icon: @image-url("../assets/icons/settings.svg"); animated: root.animated; activated => { root.open-settings(); } }
            }
        }
    }
}

component FillTrack inherits Rectangle {
    in property <int> value;
    in property <color> accent;
    in property <bool> animated: true;
    height: (10px * Tokens.panel-scale); border-radius: (5px * Tokens.panel-scale); background: #35353c;
    Rectangle {
        x: 0px; y: 0px; width: parent.width * clamp(root.value, 0, 100) / 100; height: parent.height; border-radius: (5px * Tokens.panel-scale);
        background: @linear-gradient(0deg, root.accent.darker(10%) 0%, root.accent.brighter(10%) 100%);
        animate width { duration: root.animated ? 200ms : 0ms; easing: ease-out; }
    }
}

component InfoLine inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <bool> compact: true;
    height: (root.compact ? 32px : 36px) * Tokens.panel-scale; background: transparent; border-radius: (8px * Tokens.panel-scale);
    Glyph { x: 0px; y: (parent.height - self.height) / 2; width: (18px * Tokens.panel-scale); height: (18px * Tokens.panel-scale); source: root.icon; }
    Text { x: (26px * Tokens.panel-scale); y: 0px; width: (64px * Tokens.panel-scale); height: parent.height; text: root.label; color: #d4dadd; font-size: (13px * Tokens.panel-scale); font-weight: 500; vertical-alignment: center; }
    Text { x: (90px * Tokens.panel-scale); y: 0px; width: parent.width - (90px * Tokens.panel-scale); height: parent.height; text: root.value; color: Tokens.text; font-size: (root.label == "重置时间" ? 12px : 13px) * Tokens.panel-scale; font-weight: root.label == "重置时间" ? 400 : 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
}

component ActionRow inherits Rectangle {
    in property <float> ui-scale: Tokens.panel-scale;
    in property <string> caption;
    in property <image> icon;
    in property <image> leading-icon;
    in property <bool> show-icon: false;
    in property <bool> show-leading: false;
    in property <bool> animated: true;
    callback clicked();
    height: (40px * root.ui-scale); border-radius: (8px * root.ui-scale); border-width: 1px; border-color: #494e51;
    background: hit.pressed ? #272c2e : (hit.has-hover ? #41484c : @linear-gradient(0deg, #303639 0%, #3c4347 100%));
    animate background { duration: root.animated ? 150ms : 0ms; easing: ease-out; }
    if root.show-leading: Glyph { ui-scale: root.ui-scale; x: 12px * root.ui-scale; y: (parent.height - self.height) / 2; source: root.leading-icon; }
    Text { x: root.show-leading ? 40px * root.ui-scale : 0px; y: 0px; width: parent.width - (root.show-leading ? 72px : (root.show-icon ? 32px : 0px)) * root.ui-scale; height: parent.height; text: root.caption; color: Tokens.text; font-size: (14px * root.ui-scale); font-weight: 600; horizontal-alignment: root.show-leading ? left : center; vertical-alignment: center; }
    if root.show-icon: Glyph { ui-scale: root.ui-scale; x: root.show-leading ? parent.width - (32px * root.ui-scale) : parent.width / 2 + 26px * root.ui-scale; y: (parent.height - self.height) / 2; source: root.icon; width: (16px * root.ui-scale); height: (16px * root.ui-scale); }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component DetailWindow inherits Window {
    title: "Wacu · 用量详情"; width: (296px * Tokens.panel-scale); height: expanded ? (612px * Tokens.panel-scale) : (422px * Tokens.panel-scale);
    no-frame: true; always-on-top: true; background: transparent; default-font-family: "Segoe UI";
    default-font-size: 16px;
    in property <Service> selected-service;
    in property <bool> animated: true;
    in-out property <bool> expanded: false;
    in-out property <int> selected-period: 0;
    callback close-detail();
    callback expand-detail();
    callback open-dashboard();
    Rectangle {
        x: (12px * Tokens.panel-scale); y: (12px * Tokens.panel-scale); width: parent.width - (24px * Tokens.panel-scale); height: parent.height - (24px * Tokens.panel-scale);
        border-radius: (12px * Tokens.panel-scale); border-width: 1px; border-color: #333338;
        background: @linear-gradient(135deg, #292e30 0%, #1d2224 40%, #171b1d 100%);
        drop-shadow-blur: (16px * Tokens.panel-scale); drop-shadow-offset-y: (4px * Tokens.panel-scale); drop-shadow-color: #00000040;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: (root.expanded ? 56px : 64px) * Tokens.panel-scale;
            Rectangle {
                x: (16px * Tokens.panel-scale); y: (parent.height - self.height) / 2; width: (32px * Tokens.panel-scale); height: (32px * Tokens.panel-scale); border-radius: (8px * Tokens.panel-scale);
                background: @linear-gradient(135deg, root.selected-service.accent 0%, (root.selected-service.source-index == 1 ? #ee5a30 : root.selected-service.accent.darker(15%)) 100%); border-width: 1px; border-color: root.selected-service.accent.brighter(35%);
                drop-shadow-blur: 4px * Tokens.panel-scale; drop-shadow-color: #00000040;
                Glyph { x: (4px * Tokens.panel-scale); y: (4px * Tokens.panel-scale); width: (24px * Tokens.panel-scale); height: (24px * Tokens.panel-scale); source: root.selected-service.source-index == 1 ? @image-url("../assets/icons/claude.svg") : (root.selected-service.source-index == 0 ? @image-url("../assets/icons/codex.svg") : @image-url("../assets/icons/workbuddy.svg")); }
            }
            Text { x: (58px * Tokens.panel-scale); y: 0px; width: parent.width - (132px * Tokens.panel-scale); height: parent.height; text: root.selected-service.label; color: Tokens.text; font-size: (14px * Tokens.panel-scale); font-weight: 600; vertical-alignment: center; }
            IconButton { x: parent.width - (72px * Tokens.panel-scale); y: (parent.height - self.height) / 2; icon: @image-url("../assets/icons/more.svg"); animated: root.animated; activated => { root.expand-detail(); } }
            IconButton { x: parent.width - (36px * Tokens.panel-scale); y: (parent.height - self.height) / 2; icon: @image-url("../assets/icons/close.svg"); animated: root.animated; activated => { root.close-detail(); } }
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Tokens.divider; }
        }
        VerticalLayout {
            padding-top: (root.expanded ? 68px : 76px) * Tokens.panel-scale; padding-bottom: (16px * Tokens.panel-scale); padding-left: (16px * Tokens.panel-scale); padding-right: (16px * Tokens.panel-scale); spacing: (12px * Tokens.panel-scale);
            if root.expanded: Rectangle {
                height: (32px * Tokens.panel-scale); border-radius: (8px * Tokens.panel-scale); background: Tokens.raised; border-width: 1px; border-color: #37373e;
                HorizontalLayout {
                    padding: (2px * Tokens.panel-scale); spacing: (2px * Tokens.panel-scale);
                    for name[idx] in ["今日", "7天", "30天", "全部"]: Rectangle {
                        border-radius: (6px * Tokens.panel-scale);
                        background: root.selected-period == idx ? #46464e : (period-hit.has-hover ? #33333a : transparent);
                        animate background { duration: root.animated ? 150ms : 0ms; easing: ease-out; }
                        Text { text: name; color: root.selected-period == idx ? Tokens.text : Tokens.secondary; font-size: (12px * Tokens.panel-scale); horizontal-alignment: center; vertical-alignment: center; }
                        period-hit := TouchArea { mouse-cursor: pointer; clicked => { root.selected-period = idx; } }
                    }
                }
            }
            Rectangle {
                height: (18px * Tokens.panel-scale);
                Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "用量进度"; color: Tokens.text; font-size: (13px * Tokens.panel-scale); font-weight: 600; vertical-alignment: center; }
                Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "演示数据"; color: Tokens.muted; font-size: (10px * Tokens.panel-scale); horizontal-alignment: right; vertical-alignment: center; }
            }
            Rectangle {
                height: (38px * Tokens.panel-scale);
                Text { x: 0px; y: 0px; width: (100px * Tokens.panel-scale); height: parent.height; text: root.selected-service.percent + "%"; color: Tokens.text; font-size: (32px * Tokens.panel-scale); font-weight: 700; vertical-alignment: bottom; }
                Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.selected-service.used + " / " + root.selected-service.total + " 次"; color: #e4e4e7; font-size: (13px * Tokens.panel-scale); horizontal-alignment: right; vertical-alignment: bottom; }
            }
            FillTrack { value: root.selected-service.percent; accent: root.selected-service.accent; animated: root.animated; }
            if root.expanded: Rectangle { height: 8px * Tokens.panel-scale; }
            if root.expanded: Rectangle {
                height: (132px * Tokens.panel-scale);
                // Deterministic sample history; never presented as real provider usage.
                Text { x: 0px; y: 0px; width: (25px * Tokens.panel-scale); height: (16px * Tokens.panel-scale); text: "100"; color: #d4d4d8; font-size: (10px * Tokens.panel-scale); }
                Text { x: 0px; y: (44px * Tokens.panel-scale); width: (25px * Tokens.panel-scale); height: (16px * Tokens.panel-scale); text: "50"; color: #d4d4d8; font-size: (10px * Tokens.panel-scale); }
                Text { x: 0px; y: (89px * Tokens.panel-scale); width: (25px * Tokens.panel-scale); height: (16px * Tokens.panel-scale); text: "0"; color: #d4d4d8; font-size: (10px * Tokens.panel-scale); }
                Rectangle {
                    x: (28px * Tokens.panel-scale); y: (7px * Tokens.panel-scale); width: parent.width - (28px * Tokens.panel-scale); height: (94px * Tokens.panel-scale);
                    for col in [0, 1, 2, 3, 4]: Rectangle { x: parent.width * col / 4; width: 1px; height: parent.height; background: #363b3c; }
                    Rectangle { x: 0px; y: parent.height / 2; height: 1px; width: parent.width; background: #292d2e; }
                    Rectangle { x: 0px; y: parent.height; height: 1px; width: parent.width; background: #48484e; }
                    HorizontalLayout {
                        spacing: (4px * Tokens.panel-scale);
                        for fraction in [0.07, 0.17, 0.14, 0.26, 0.11, 0.15, 0.23, 0.43, 0.25, 0.88, 0.14, 0.06, 0.1, 0.23, 0.32, 0.35, 0.47, 0.62, 0.84, 0.33, 0.16, 0.11, 0.07, 0.12]: Rectangle {
                            Rectangle {
                                height: parent.height * (root.selected-period == 0 ? fraction : (root.selected-period == 1 ? 0.1 + fraction * 0.6 : (root.selected-period == 2 ? 0.2 + fraction * 0.7 : 0.15 + fraction * 0.8)));
                                x: 0px; y: parent.height - self.height; width: parent.width; border-radius: 1px;
                                background: @linear-gradient(0deg, root.selected-service.accent.darker(30%) 0%, root.selected-service.accent 100%);
                                animate height { duration: root.animated ? 200ms : 0ms; easing: ease-out; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: (107px * Tokens.panel-scale); padding-left: (21px * Tokens.panel-scale); height: (124px * Tokens.panel-scale);
                    for label in (root.selected-period == 0 ? ["0时", "6时", "12时", "18时", "24时"] : (root.selected-period == 1 ? ["1天", "2天", "4天", "6天", "7天"] : (root.selected-period == 2 ? ["1日", "7日", "15日", "23日", "30日"] : ["起始", "", "累计", "", "现在"]))): Text { text: label; color: #d4d4d8; font-size: (10px * Tokens.panel-scale); horizontal-alignment: center; }
                }
            }
            Rectangle {
                height: (root.expanded ? 120px : 136px) * Tokens.panel-scale; border-radius: (8px * Tokens.panel-scale); background: @linear-gradient(135deg, #2a2f31 0%, #24292b 100%); border-width: 1px; border-color: #373e42;
                VerticalLayout {
                    padding-top: (root.expanded ? 12px : 14px) * Tokens.panel-scale; padding-bottom: (root.expanded ? 12px : 14px) * Tokens.panel-scale; padding-left: (12px * Tokens.panel-scale); padding-right: (12px * Tokens.panel-scale); spacing: 0px;
                    InfoLine { compact: root.expanded; icon: @image-url("../assets/icons/clock.svg"); label: "今日用量"; value: root.selected-service.used + " 次"; }
                    InfoLine { compact: root.expanded; icon: @image-url("../assets/icons/calendar.svg"); label: "剩余额度"; value: root.selected-service.remaining + " 次"; }
                    InfoLine { compact: root.expanded; icon: @image-url("../assets/icons/clock.svg"); label: "重置时间"; value: root.selected-service.reset; }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ActionRow {
                height: root.expanded ? (48px * Tokens.panel-scale) : (40px * Tokens.panel-scale); caption: root.expanded ? "在官网查看" : "查看详细用量";
                icon: root.expanded ? @image-url("../assets/icons/external.svg") : @image-url("../assets/icons/chevron.svg"); animated: root.animated;
                leading-icon: root.expanded ? @image-url("") : @image-url("../assets/icons/usage.svg");
                show-icon: true; show-leading: !root.expanded;
                clicked => { if root.expanded { root.open-dashboard(); } else { root.expand-detail(); } }
            }
        }
    }
}

component SettingSwitch inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> animated: true;
    callback changed(bool);
    height: (54px * Tokens.settings-scale);
    Text { x: 0px; y: (4px * Tokens.settings-scale); width: parent.width - (48px * Tokens.settings-scale); height: (20px * Tokens.settings-scale); text: root.label; color: Tokens.text; font-size: (14px * Tokens.settings-scale); vertical-alignment: center; }
    Text { x: 0px; y: (27px * Tokens.settings-scale); width: parent.width - (48px * Tokens.settings-scale); height: (16px * Tokens.settings-scale); text: root.hint; color: Tokens.secondary; font-size: (11px * Tokens.settings-scale); vertical-alignment: center; overflow: elide; }
    Rectangle {
        x: parent.width - (40px * Tokens.settings-scale); y: (8px * Tokens.settings-scale); width: (40px * Tokens.settings-scale); height: (22px * Tokens.settings-scale); border-radius: (11px * Tokens.settings-scale);
        background: root.checked ? @linear-gradient(90deg, #087aff 0%, #0098ff 100%) : #515962;
        animate background { duration: root.animated ? 150ms : 0ms; easing: ease-out; }
        Rectangle { x: root.checked ? (20px * Tokens.settings-scale) : (2px * Tokens.settings-scale); y: (2px * Tokens.settings-scale); width: (18px * Tokens.settings-scale); height: (18px * Tokens.settings-scale); border-radius: (9px * Tokens.settings-scale); background: #fff; animate x { duration: root.animated ? 150ms : 0ms; easing: ease-out; } }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.changed(!root.checked); } }
}

component SideNav inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> animated: true;
    callback clicked();
    height: (38px * Tokens.settings-scale); border-radius: (8px * Tokens.settings-scale);
    background: root.selected ? @linear-gradient(90deg, #173a56 0%, #1c425f 100%) : (hit.has-hover ? #262c30 : transparent);
    animate background { duration: root.animated ? 150ms : 0ms; easing: ease-out; }
    if root.selected: Rectangle { x: 0px; y: (5px * Tokens.settings-scale); width: (3px * Tokens.settings-scale); height: parent.height - (10px * Tokens.settings-scale); border-radius: (2px * Tokens.settings-scale); background: Tokens.blue; }
    Glyph { ui-scale: Tokens.settings-scale; x: (10px * Tokens.settings-scale); y: (parent.height - self.height) / 2; width: 18px; height: 18px; source: root.icon; }
    Text { x: (36px * Tokens.settings-scale); y: 0px; width: parent.width - (40px * Tokens.settings-scale); height: parent.height; text: root.label; color: Tokens.text; font-size: (14px * Tokens.settings-scale); font-weight: root.selected ? 500 : 400; vertical-alignment: center; }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
component SectionTitle inherits Text { height: (24px * Tokens.settings-scale); color: Tokens.text; font-size: (16px * Tokens.settings-scale); font-weight: 600; }
// Keep the native ComboBox's popup, focus, keyboard and accessibility behavior.
// The drawing above it supplies the approved rounded surface and chevron.
component SettingSelect inherits Rectangle {
    in property <[string]> model;
    in property <int> index: 0;
    callback selected(int);
    border-radius: 8px * Tokens.settings-scale; clip: true;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; opacity: 0;
        combo := ComboBox {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            model: root.model; current-index: root.index;
            selected(value) => { root.selected(self.current-index); }
        }
    }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 8px * Tokens.settings-scale; border-width: 1px;
        border-color: combo.has-focus ? #438cff : #42494e;
        background: @linear-gradient(0deg, #262c30 0%, #30373b 100%);
        Text { x: 12px * Tokens.settings-scale; y: 0px; width: parent.width - 40px * Tokens.settings-scale; height: parent.height; text: root.model[root.index]; color: #e2e6e8; font-size: 14px * Tokens.settings-scale; vertical-alignment: center; }
        Glyph { ui-scale: Tokens.settings-scale; x: parent.width - 28px * Tokens.settings-scale; y: (parent.height - self.height) / 2; width: 16px * Tokens.settings-scale; height: self.width; source: @image-url("../assets/icons/down.svg"); }
    }
}

component OpacityRow inherits Rectangle {
    in property <float> value;
    callback changed(float);
    height: (36px * Tokens.settings-scale);
    Text { x: 0px; y: 0px; width: (64px * Tokens.settings-scale); height: parent.height; text: "透明度"; font-size: (13px * Tokens.settings-scale); color: Tokens.text; vertical-alignment: center; }
    Rectangle {
        x: (70px * Tokens.settings-scale); y: (3px * Tokens.settings-scale); width: parent.width - (111px * Tokens.settings-scale); height: (30px * Tokens.settings-scale);
        // Retain native pointer, keyboard and accessibility handling beneath the drawing.
        Slider { x: 0px; y: 0px; width: parent.width; height: parent.height; opacity: 0; minimum: 65; maximum: 100; value: root.value; changed => { root.changed(self.value); } }
        Rectangle {
            x: 10px; y: (parent.height - self.height) / 2; width: parent.width - 20px; height: 6px * Tokens.settings-scale; border-radius: self.height / 2; background: #41494f;
            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp((root.value - 65) / 35, 0, 1); border-radius: parent.border-radius; background: @linear-gradient(90deg, #087aff 0%, #0098ff 100%); }
        }
        Rectangle {
            x: (parent.width - self.width) * clamp((root.value - 65) / 35, 0, 1); y: (parent.height - self.height) / 2; width: 20px; height: 20px; border-radius: 10px;
            background: Tokens.blue; border-width: 1.5px; border-color: #edf6ff; drop-shadow-blur: 3px; drop-shadow-color: #00000040;
        }
    }
    Text { width: (38px * Tokens.settings-scale); x: parent.width - (38px * Tokens.settings-scale); y: 0px; height: parent.height; text: round(root.value) + "%"; color: Tokens.text; font-size: (12px * Tokens.settings-scale); horizontal-alignment: right; vertical-alignment: center; }
}
component PositionRow inherits Rectangle {
    in property <int> side;
    callback changed(int);
    height: (36px * Tokens.settings-scale);
    Text { x: 0px; y: 0px; width: (64px * Tokens.settings-scale); height: parent.height; text: "胶囊位置"; color: Tokens.text; font-size: (13px * Tokens.settings-scale); vertical-alignment: center; }
    SettingSelect { x: round(74 * Tokens.settings-scale) * 1px; y: 0px; width: parent.width - self.x; height: parent.height; model: ["右侧", "左侧"]; index: root.side; selected(value) => { root.changed(value); } }
}

export component SettingsWindow inherits Window {
    title: "Wacu · 设置"; width: 460px; height: 600px;
    background: transparent; no-frame: true; default-font-family: "Segoe UI";
    default-font-size: 16px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in-out property <bool> pinned-mode: false;
    in-out property <bool> show-codex: true;
    in-out property <bool> show-claude: true;
    in-out property <bool> show-workbuddy: true;
    in-out property <bool> animations-on: true;
    in-out property <bool> startup-on: false;
    in-out property <bool> edge-hide-on: false;
    in-out property <int> dock-side: 0;
    in-out property <float> opacity-percent: 95;
    in-out property <int> capsule-size: 1;
    in-out property <int> selected-page: 0;
    in-out property <string> status-message: "";
    callback set-pinned(bool);
    callback toggle-service(int, bool);
    callback close-settings();
    callback start-settings-drag();
    callback set-animations(bool);
    callback set-opacity(float);
    callback set-capsule-size(int);
    callback set-startup(bool);
    callback set-edge-hide(bool);
    callback set-dock-side(int);
    callback reset-position();
    callback open-link(int);
    Rectangle {
        x: (12px * Tokens.settings-scale); y: (12px * Tokens.settings-scale); width: parent.width - (24px * Tokens.settings-scale); height: parent.height - (24px * Tokens.settings-scale);
        border-radius: (12px * Tokens.settings-scale); border-width: 1px; border-color: #35353b;
        background: @linear-gradient(135deg, #282d2f 0%, #1d2224 45%, #191d1f 100%);
        drop-shadow-blur: (16px * Tokens.settings-scale); drop-shadow-offset-y: (4px * Tokens.settings-scale); drop-shadow-color: #00000040;
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: (52px * Tokens.settings-scale);
                Glyph { ui-scale: Tokens.settings-scale; x: (18px * Tokens.settings-scale); y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/settings.svg"); }
                Text { x: (48px * Tokens.settings-scale); y: 0px; height: parent.height; text: "Wacu 设置"; color: Tokens.text; font-size: (18px * Tokens.settings-scale); font-weight: 500; vertical-alignment: center; }
                TouchArea { width: parent.width - (48px * Tokens.settings-scale); height: parent.height; mouse-cursor: grab; pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.start-settings-drag(); } } }
                IconButton { ui-scale: Tokens.settings-scale; x: parent.width - (40px * Tokens.settings-scale); y: (parent.height - self.height) / 2; icon: @image-url("../assets/icons/close.svg"); animated: root.animations-on; activated => { root.close-settings(); } }
            }
            Rectangle { height: 1px; background: Tokens.divider; }
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    width: (116px * Tokens.settings-scale);
                    VerticalLayout {
                        padding-top: (10px * Tokens.settings-scale); padding-left: (8px * Tokens.settings-scale); padding-right: (8px * Tokens.settings-scale); spacing: (4px * Tokens.settings-scale);
                        SideNav { label: "常规"; icon: @image-url("../assets/icons/settings.svg"); animated: root.animations-on; selected: root.selected-page == 0; clicked => { root.selected-page = 0; } }
                        SideNav { label: "服务管理"; icon: @image-url("../assets/icons/grid.svg"); animated: root.animations-on; selected: root.selected-page == 1; clicked => { root.selected-page = 1; } }
                        SideNav { label: "外观"; icon: @image-url("../assets/icons/palette.svg"); animated: root.animations-on; selected: root.selected-page == 2; clicked => { root.selected-page = 2; } }
                        SideNav { label: "行为"; icon: @image-url("../assets/icons/tune.svg"); animated: root.animations-on; selected: root.selected-page == 3; clicked => { root.selected-page = 3; } }
                        SideNav { label: "关于"; icon: @image-url("../assets/icons/info.svg"); animated: root.animations-on; selected: root.selected-page == 4; clicked => { root.selected-page = 4; } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { width: 1px; background: Tokens.divider; }
                Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-top: (12px * Tokens.settings-scale); padding-bottom: (12px * Tokens.settings-scale); padding-left: (16px * Tokens.settings-scale); padding-right: (16px * Tokens.settings-scale); spacing: (10px * Tokens.settings-scale);
                        if root.selected-page == 0: VerticalLayout {
                            spacing: 0px;
                            SettingSwitch { label: "开机启动"; hint: "系统启动时自动运行 Wacu"; checked: root.startup-on; animated: root.animations-on; changed(value) => { root.set-startup(value); } }
                            SettingSwitch { label: "常驻显示"; hint: "在桌面侧边显示胶囊"; checked: root.pinned-mode; animated: root.animations-on; changed(value) => { root.set-pinned(value); } }
                            SettingSwitch { label: "贴边隐藏"; hint: "靠近屏幕边缘时自动隐藏"; checked: root.edge-hide-on; animated: root.animations-on; changed(value) => { root.set-edge-hide(value); } }
                            SettingSwitch { label: "显示动画"; hint: "启用界面动画效果"; checked: root.animations-on; animated: root.animations-on; changed(value) => { root.set-animations(value); } }
                            Rectangle { height: (8px * Tokens.settings-scale); }
                            Rectangle { height: 1px; background: Tokens.divider; }
                            Rectangle { height: (10px * Tokens.settings-scale); }
                            OpacityRow { value: root.opacity-percent; changed(value) => { root.set-opacity(value); } }
                            Rectangle { height: (8px * Tokens.settings-scale); }
                            PositionRow { side: root.dock-side; changed(value) => { root.set-dock-side(value); } }
                            Rectangle { height: (8px * Tokens.settings-scale); }
                            Rectangle {
                                height: (36px * Tokens.settings-scale);
                                Text { x: 0px; y: 0px; width: (64px * Tokens.settings-scale); height: parent.height; text: "语言"; color: Tokens.text; font-size: (13px * Tokens.settings-scale); vertical-alignment: center; }
                                SettingSelect { x: round(74 * Tokens.settings-scale) * 1px; y: 0px; width: parent.width - self.x; height: parent.height; model: ["简体中文"]; index: 0; }
                            }
                            Rectangle { height: (10px * Tokens.settings-scale); }
                            Rectangle {
                                height: (36px * Tokens.settings-scale);
                                Text { x: 0px; y: 0px; width: (64px * Tokens.settings-scale); height: parent.height; text: "检查更新"; color: Tokens.text; font-size: (13px * Tokens.settings-scale); vertical-alignment: center; }
                                ActionRow { ui-scale: Tokens.settings-scale; x: (74px * Tokens.settings-scale); y: 0px; width: parent.width - (74px * Tokens.settings-scale); height: parent.height; caption: "检查更新"; animated: root.animations-on; clicked => { root.open-link(3); } }
                            }
                        }
                        if root.selected-page == 1: VerticalLayout {
                            spacing: (8px * Tokens.settings-scale);
                            SectionTitle { text: "服务管理"; }
                            Text { height: (32px * Tokens.settings-scale); text: "选择胶囊中显示的服务"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); vertical-alignment: center; }
                            SettingSwitch { label: "Claude Code"; hint: "Anthropic · Claude"; checked: root.show-claude; animated: root.animations-on; changed(value) => { root.toggle-service(1, value); } }
                            SettingSwitch { label: "Codex"; hint: "OpenAI · ChatGPT"; checked: root.show-codex; animated: root.animations-on; changed(value) => { root.toggle-service(0, value); } }
                            SettingSwitch { label: "WorkBuddy"; hint: "积分额度"; checked: root.show-workbuddy; animated: root.animations-on; changed(value) => { root.toggle-service(2, value); } }
                            Text { height: (52px * Tokens.settings-scale); text: "用量与图表均为演示数据。\n尚未连接真实账户。"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); wrap: word-wrap; }
                        }
                        if root.selected-page == 2: VerticalLayout {
                            spacing: (12px * Tokens.settings-scale);
                            SectionTitle { text: "外观"; }
                            Text {
                                height: (20px * Tokens.settings-scale); text: "胶囊大小";
                                color: Tokens.text; font-size: (13px * Tokens.settings-scale);
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: (42px * Tokens.settings-scale); spacing: (7px * Tokens.settings-scale);
                                for size-name[idx] in ["紧凑", "标准", "宽松"]: Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: (8px * Tokens.settings-scale); border-width: 1px;
                                    border-color: root.capsule-size == idx ? #429ffd : #414149;
                                    background: root.capsule-size == idx ? #1c405e : #26262b;
                                    animate background, border-color { duration: root.animations-on ? 150ms : 0ms; easing: ease-out; }
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: size-name;
                                        font-size: (13px * Tokens.settings-scale);
                                        font-weight: root.capsule-size == idx ? 600 : 400;
                                        color: root.capsule-size == idx ? #edf7ff : #bdbdc7;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-capsule-size(idx); }
                                    }
                                }
                            }
                            Text {
                                height: (20px * Tokens.settings-scale); text: "选择后立即生效，重启也会记住";
                                color: Tokens.secondary; font-size: (11px * Tokens.settings-scale);
                                vertical-alignment: center;
                            }
                            OpacityRow { value: root.opacity-percent; changed(value) => { root.set-opacity(value); } }
                            PositionRow { side: root.dock-side; changed(value) => { root.set-dock-side(value); } }
                            Rectangle { height: 1px; background: Tokens.divider; }
                            SectionTitle { text: "服务配色"; }
                            HorizontalLayout {
                                height: (36px * Tokens.settings-scale); spacing: (12px * Tokens.settings-scale); alignment: start;
                                Rectangle { width: (32px * Tokens.settings-scale); height: (32px * Tokens.settings-scale); border-radius: (16px * Tokens.settings-scale); background: #22c55e; }
                                Rectangle { width: (32px * Tokens.settings-scale); height: (32px * Tokens.settings-scale); border-radius: (16px * Tokens.settings-scale); background: #ff8a4c; }
                                Rectangle { width: (32px * Tokens.settings-scale); height: (32px * Tokens.settings-scale); border-radius: (16px * Tokens.settings-scale); background: #8b5cf6; }
                            }
                            Text { height: (32px * Tokens.settings-scale); text: "Windows 11 深色风格"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); }
                        }
                        if root.selected-page == 3: VerticalLayout {
                            spacing: (12px * Tokens.settings-scale);
                            SectionTitle { text: "行为"; }
                            SettingSwitch { label: "显示动画"; hint: "启用悬停、按下和展开过渡"; checked: root.animations-on; animated: root.animations-on; changed(value) => { root.set-animations(value); } }
                            SettingSwitch { label: "贴边隐藏"; hint: "移到屏幕边缘可恢复胶囊"; checked: root.edge-hide-on; animated: root.animations-on; changed(value) => { root.set-edge-hide(value); } }
                            ActionRow { ui-scale: Tokens.settings-scale; caption: "恢复胶囊默认位置"; animated: root.animations-on; clicked => { root.reset-position(); } }
                            Text { height: (70px * Tokens.settings-scale); text: "弹出模式下，点击空白处收起。\n常驻模式可按住胶囊顶端拖动。"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); wrap: word-wrap; }
                        }
                        if root.selected-page == 4: VerticalLayout {
                            spacing: (16px * Tokens.settings-scale);
                            SectionTitle { text: "关于 Wacu"; }
                            Text { height: (36px * Tokens.settings-scale); text: "静静守望，每一份余量。"; color: Tokens.text; font-size: (14px * Tokens.settings-scale); }
                            Text { height: (24px * Tokens.settings-scale); text: "版本 0.2.0"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); }
                            Text { height: (64px * Tokens.settings-scale); text: "轻量、简洁、不打扰。\n用量数据与历史图表为演示，\n尚未连接真实账户。"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); wrap: word-wrap; }
                            ActionRow { ui-scale: Tokens.settings-scale; caption: "开源项目"; icon: @image-url("../assets/icons/external.svg"); show-icon: true; animated: root.animations-on; clicked => { root.open-link(0); } }
                        }
                        if root.status-message != "": Text { height: (32px * Tokens.settings-scale); text: root.status-message; color: #f59e0b; font-size: (11px * Tokens.settings-scale); wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            Rectangle { height: 1px; background: Tokens.divider; }
            Rectangle {
                height: (36px * Tokens.settings-scale);
                Text { x: (16px * Tokens.settings-scale); y: 0px; height: parent.height; text: "Wacu v0.2.0"; color: Tokens.secondary; font-size: (12px * Tokens.settings-scale); vertical-alignment: center; }
                HorizontalLayout {
                    padding-left: (235px * Tokens.settings-scale); padding-right: (16px * Tokens.settings-scale); alignment: end; spacing: (12px * Tokens.settings-scale);
                    for caption[idx] in ["开源", "反馈", "帮助"]: Rectangle {
                        Text { text: caption; color: link.has-hover ? #85c5ff : #2997ff; font-size: (11px * Tokens.settings-scale); horizontal-alignment: center; vertical-alignment: center; }
                        link := TouchArea { mouse-cursor: pointer; clicked => { root.open-link(idx); } }
                    }
                }
            }
        }
    }
}

export component WacuTray inherits SystemTrayIcon {
    in property <image> tray-icon;
    icon: root.tray-icon; tooltip: "Wacu · AI 用量守望";
    callback tray-clicked();
    clicked => { root.tray-clicked(); }
    callback show-settings();
    callback switch-mode();
    callback exit-app();
    Menu {
        MenuItem { title: "显示 / 隐藏胶囊"; activated => { root.tray-clicked(); } }
        MenuItem { title: "设置"; activated => { root.show-settings(); } }
        MenuItem { title: "切换弹出 / 常驻"; activated => { root.switch-mode(); } }
        MenuSeparator {}
        MenuItem { title: "退出 Wacu"; activated => { root.exit-app(); } }
    }
}
